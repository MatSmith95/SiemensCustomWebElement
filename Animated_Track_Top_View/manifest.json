{
  "$schema": "./CWC_manifest_Schema.json",
  "mver": "1.2.0",
  "control": {
    "identity": {
      "name": "AnimatedTrackTopView",
      "version": "1.1",
      "displayname": "Animated Track Top View",
      "icon": "./assets/logo.png",
      "type": "guid://897B2819-0786-452E-B639-DB45EFFB90F8",
      "start": "./control/index.html"
    },
    "environment": {
      "prerequisites": {
        "renderingspace": {
          "minwidth": 200,
          "minheight": 300,
          "defaultwidth": 400,
          "defaultheight": 640,
          "unit": "px"
        }
      }
    },
    "metadata": {
      "author": "Mathew Smith",
      "keywords": [
        "Track",
        "TrackedVehicle",
        "TankTrack",
        "TopView",
        "Animation",
        "WinCCUnified",
        "CustomWebControl"
      ]
    },
    "contracts": {
      "api": {
        "methods": {
          "SetSpeed": {
            "parameters": {
              "speed": {
                "type": "number"
              }
            },
            "description": "Set the signed track speed."
          },
          "StopAnimation": {
            "description": "Set the track speed to zero."
          },
          "SetEnabled": {
            "parameters": {
              "enabled": {
                "type": "boolean"
              }
            },
            "description": "Enable or pause track animation."
          }
        },
        "events": {
          "TrackStateChanged": {
            "arguments": {
              "payload": {
                "type": "string"
              }
            },
            "description": "Fired when the displayed track motion state changes."
          }
        },
        "properties": {
          "TrackSpeed": {
            "type": "number",
            "default": 0,
            "description": "Signed track speed. Positive moves towards the top of the control."
          },
          "MaxSpeed": {
            "type": "number",
            "default": 100,
            "description": "Absolute input speed represented by maximum animation speed."
          },
          "AnimationScale": {
            "type": "number",
            "default": 1,
            "description": "Visual animation speed multiplier."
          },
          "Enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable track animation."
          },
          "ReverseDirection": {
            "type": "boolean",
            "default": false,
            "description": "Reverse the displayed track direction."
          },
          "RotationAngle": {
            "type": "number",
            "default": 0,
            "description": "Rotate the displayed track visual in degrees."
          },
          "TreadCount": {
            "type": "number",
            "default": 18,
            "description": "Number of visible tread pads on the track."
          },
          "ShowValues": {
            "type": "boolean",
            "default": false,
            "description": "Show the track speed value."
          },
          "Alarm": {
            "type": "boolean",
            "default": false,
            "description": "Highlight the control using the alarm color."
          },
          "BackgroundColor": {
            "$ref": "#/control/types/Color",
            "default": 0
          },
          "TrackColor": {
            "$ref": "#/control/types/Color",
            "default": 4280297784
          },
          "TreadColor": {
            "$ref": "#/control/types/Color",
            "default": 4282074711
          },
          "AccentColor": {
            "$ref": "#/control/types/Color",
            "default": 4281908728
          },
          "AlarmColor": {
            "$ref": "#/control/types/Color",
            "default": 4293870660
          }
        }
      }
    },
    "types": {
      "Color": {
        "$id": "http://tia.siemens.com/wincc-unified/types/s/color",
        "type": "number"
      }
    }
  }
}
