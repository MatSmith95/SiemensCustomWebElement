{
  "$schema": "./CWC_manifest_Schema.json",
  "mver": "1.2.0",
  "control": {
    "identity": {
      "name": "DatapathWallControl",
      "version": "0.1",
      "displayname": "Datapath Wall Control",
      "icon": "./assets/logo.png",
      "type": "guid://54F807D6-B8B8-4932-979D-598BE46E6A03",
      "start": "./control/index.html"
    },
    "environment": {
      "prerequisites": {
        "renderingspace": {
          "minwidth": 720,
          "minheight": 360,
          "defaultwidth": 1100,
          "defaultheight": 520,
          "unit": "px"
        }
      }
    },
    "metadata": {
      "author": "Mathew Smith",
      "description": "Configurable Datapath video wall operator control for WinCC Unified.",
      "keywords": [
        "Datapath",
        "VideoWall",
        "SCADA",
        "WinCCUnified",
        "CustomWebControl"
      ]
    },
    "contracts": {
      "api": {
        "methods": {
          "ReloadJson": {
            "description": "Reload the wall, input, state and result JSON files."
          },
          "OpenConfigurationStudio": {
            "description": "Open the Datapath Configuration Studio when EditPermit is true."
          },
          "CloseConfigurationStudio": {
            "description": "Close the Datapath Configuration Studio."
          }
        },
        "events": {
          "CommandWritten": {
            "arguments": {
              "payload": {
                "type": "string"
              }
            },
            "description": "Fired after the control writes a pending-command JSON payload."
          },
          "ConfigurationSaved": {
            "arguments": {
              "payload": {
                "type": "string"
              }
            },
            "description": "Fired after the control saves a configuration JSON file."
          },
          "FileError": {
            "arguments": {
              "payload": {
                "type": "string"
              }
            },
            "description": "Fired when a JSON file cannot be read, parsed or written."
          }
        },
        "properties": {
          "JsonFolderPath": {
            "type": "string",
            "default": "",
            "description": "Folder path for Datapath JSON documents."
          },
          "EditPermit": {
            "type": "boolean",
            "default": false,
            "description": "Show the Datapath Configuration Studio pencil button."
          },
          "Enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable operator source switching."
          },
          "RefreshIntervalMs": {
            "type": "number",
            "default": 2000,
            "description": "Polling interval for Datapath JSON state files."
          },
          "SelectedSourceId": {
            "type": "string",
            "default": "",
            "description": "Currently selected source/input id."
          },
          "SelectedTargetId": {
            "type": "string",
            "default": "",
            "description": "Last selected target zone id."
          },
          "SelectedLayoutId": {
            "type": "string",
            "default": "",
            "description": "Last selected layout id."
          },
          "PendingCommandJson": {
            "type": "string",
            "default": "",
            "description": "Last command payload written by the operator."
          },
          "CommandSequence": {
            "type": "number",
            "default": 0,
            "description": "Incremented every time a command is written."
          },
          "StatusText": {
            "type": "string",
            "default": "Ready",
            "description": "Latest control, file or Datapath status text."
          },
          "BackgroundColor": {
            "$ref": "#/control/types/Color",
            "default": 4278190080,
            "description": "Control background colour in WinCC Unified ARGB format."
          },
          "AccentColor": {
            "$ref": "#/control/types/Color",
            "default": 4280457183,
            "description": "Selection accent colour in WinCC Unified ARGB format."
          }
        }
      }
    },
    "types": {
      "Color": {
        "$id": "http://tia.siemens.com/wincc-unified/types/s/color",
        "type": "number"
      }
    }
  }
}
